# Secrets Configuration
# This file serves as the single source of truth for all environment variables.
# Do not commit real keys to this file. Use a `.env` file instead.

# Google Workspace / Sheets Integration
# Path to the Google Service Account JSON credentials file
GOOGLE_APPLICATION_CREDENTIALS=
# ID of the Google Sheet containing the 7 tabs
GOOGLE_SHEET_ID=
# If using a specific Cloud Project ID
GOOGLE_CLOUD_PROJECT_ID=

# AI & Gemini API
# Server-side key for Google Gemini logic
GEMINI_API_KEY=
NEWSDATA_API_KEY=
# Invidious Video API Key / Secret (Optional for https://inv.nadeko.net)
INVIDIOUS_API_KEY=
INVIDIOUS_SECRET=
# Endpoint or key for Gemini Live (Realtime Voice)
GEMINI_LIVE_API_KEY=

# Real-Time & Signaling
# WebRTC / Socket signaling server endpoint (e.g. wss://rms.metered.ca/v1?key=...)
WEBRTC_SIGNALING_URL=

# Free & Open Media APIs (NO APPROVAL REQUIRED / KEYLESS REPLACEMENTS)
# Radio Browser API endpoint for free ambient radio streams (default: https://de1.api.radio-browser.info)
RADIO_BROWSER_API_URL="https://de1.api.radio-browser.info"
# Open Library API endpoint for books & reading list (default: https://openlibrary.org)
OPEN_LIBRARY_API_URL="https://openlibrary.org"
# Optional key if using Google Books API for extended book metadata
GOOGLE_BOOKS_API_KEY=

# System Preferences
ASSISTANT_WAKE_NAME="Hey Avenly"
GPIO_PIN_MAP_JSON="{\"stepper\":[17,27,22,23],\"servo\":13,\"led\":26}"
CAROUSEL_SLOT_COUNT=20
