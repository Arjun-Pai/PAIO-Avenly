{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile and care details",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 100
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 500
        },
        "primaryPhone": {
          "type": "string",
          "maxLength": 30
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["fullName", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/userProfile"
      },
      "description": "User documents keyed by user ID"
    }
  }
}
